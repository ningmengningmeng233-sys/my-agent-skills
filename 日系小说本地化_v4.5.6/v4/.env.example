# v4 Core 不依赖外部资产；以下路径用于可选 Enhance，请改为本机实际路径。
INDEX_LIB_DIR=
WRITING_GUIDE_DIR=

# OpenAI 兼容 Chat Completions 配置。密钥只放在用户环境变量或本地未跟踪配置中。
NOVEL_LLM_PROVIDER=deepseek
NOVEL_LLM_ENABLED=1
NOVEL_LLM_DRY_RUN=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=8192
