# 转录索引示例配置：复制到用户私有配置目录后填写，不要把真实密钥放入技能目录。
# Windows 推荐目录：%USERPROFILE%/.config/转录索引/.env
# 或设置 TRANSCRIPT_INDEX_CONFIG_DIR 指向自定义配置目录。
SRC_DIR=D:/你的/Obsidian/转录TXT目录
# 兼容 OpenAI Chat Completions 协议的服务商密钥（当前默认服务商为 DeepSeek）
OPENAI_API_KEY=替换为你的API Key
SUMMARY_API_URL=https://api.deepseek.com/v1/chat/completions
SUMMARY_API_MODEL=deepseek-chat
EMBED_MODEL=BAAI/bge-small-zh-v1.5
CONCURRENCY=8
MAX_RETRY=3
API_TIMEOUT=240
STRICT_BILIBILI=1
ALLOW_SOURCE_WRITE=0
AUTO_TERM=0
# 可选：模型、词表和快照路径
# TERM_TABLE=D:/你的/Obsidian/转录TXT目录/索引配置/术语表.md
# TAG_TABLE=D:/你的/Obsidian/转录TXT目录/索引配置/标签词表.md
# SNAPSHOT_DEST=D:/桌面/知识库索引/v2
