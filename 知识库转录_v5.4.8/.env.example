# ============================================================
# 知识库索引 v5.4.6 - 配置模板
# 复制此文件为 .env 并填入你的配置（.env 已被 git 忽略）
# ============================================================

# ---- LLM API：多节点故障转移池（v5.4.1 唯一调用路径） ----
# 节点定义在 <技能目录>/llm_nodes.json（复制 llm_nodes.json.example 后填入密钥）。
# 数组顺序即消耗优先级：前一个节点额度耗尽/不可用时，自动顺切下一个节点。
# 建库前先体检各节点连通性：python scripts/probe_pool.py
# 本项留空则默认 <技能目录>/llm_nodes.json
LLM_NODES_CONFIG=

# 注：v5.4.1 起建索引不再读取 OPENAI_API_KEY / SUMMARY_API_URL / SUMMARY_API_MODEL，
# 全部 LLM 调用统一经 llm_nodes.json 节点池（白名单约束，不访问列表外任何 API）。

# ---- 知识库根目录（外置数据，不随技能包分发） ----
# 结构: <INDEX_LIB_DIR>/原文/  <INDEX_LIB_DIR>/书导航/  <INDEX_LIB_DIR>/段索引/
# 留空则默认 <技能目录>/索引库/
INDEX_LIB_DIR=

# ---- 建索引执行器 ----
# direct   = 直调引擎（默认，32路并行+断点+双层行号校准，高效）
# subagent = 子代理派发（需要宿主提供 Agent/子代理能力；不确定时使用 direct）
INDEX_EXECUTOR=direct

# ---- 可选语义/向量检索 ----
# 设置为 1 启用语义向量辅助召回；需先安装可选依赖：
#   pip install "knowledge-index[semantic]"
# 手动构建：python scripts/semantic_index.py --build --lib <知识库>
# 语义检索：python scripts/semantic_search.py "查询" --lib <知识库>
# INDEX_ENABLE_SEMANTIC=0
#
# 向量模型：**留空即按本机硬件自适配**（推荐，无需手填）
#   自动探测 nvidia-smi 显存 + 系统内存，挑本机可承载的最优模型，
#   并优先复用 Ollama 已安装的模型（避免强制下载 4GB 模型）。
#   分档规则：显存≥6GB → qwen3-embedding:8b ｜ ≥3.5GB → 4b ｜ 其余/无GPU → 0.6b
#   查看本机自适配结果：python scripts/hardware_profile.py
# 如需强制指定，取消注释并填模型名（用户指定优先于自适配）：
# INDEX_EMBEDDING_MODEL=qwen3-embedding:0.6b
#
# 注意：Ollama 不会开机自启，但脚本已内置自愈——检测到本机未运行时会自动
#   执行 `ollama serve` 并等待就绪。仅在未安装 Ollama 时才回退到其他引擎。
