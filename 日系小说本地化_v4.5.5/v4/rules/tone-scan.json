  "density_patterns": [
    {
      "name": "句尾嘛密度",
      "pattern": "(?<!干|那|什|怎)嘛(?=[，。！？!?～~…\n]|$)",
      "per_wan": 6,
      "severity": "blocked"
    },
    {
      "name": "句尾呢密度",
      "pattern": "(?<![。！？…])呢(?=[。！？…」』\"\n]|$)",
      "per_wan": 12,
      "severity": "blocked"
    },
    {
      "name": "句尾啦密度",
      "pattern": "(?<![哗唰喀啪沙咕])啦(?=[！。！？，～…]|$)",
      "per_wan": 8,
      "severity": "warning"
    }
