# ============================================================
# Bilibili Auto Transcript - 配置
# 复制此文件为 .env 并填入你的配置
# ============================================================

# ---- B站收藏夹 ----
# 收藏夹ID（从收藏夹URL ?fid= 后的数字获取）
FAV_MEDIA_ID=

# ---- 多P（分P）视频 ----
# true：收藏夹扫描时把多P视频展开为每P一个独立任务（BVxxx_P2、BVxxx_P3…）
# false（默认）：每个 BV 只转录第1P，行为与旧版一致
EXPAND_PAGES=false

# ---- 批量归档和模型（可选） ----
# 默认归档到技能目录/转录文件/已转录/年/月
# BILI_ARCHIVE_DIR=C:/path/to/转录文件/已转录
# GPU 默认 small；可按精度/速度需求覆盖
# BILI_WHISPER_MODEL=small

# ---- AI 摘要（可选） ----
# 支持任何 OpenAI 兼容 API（DeepSeek、OpenCode Go、OpenRouter 等）
#
# 示例配置：
#
# --- DeepSeek 官方 ---
# OPENAI_API_KEY=sk-xxx
# SUMMARY_API_URL=https://api.deepseek.com
# SUMMARY_API_MODEL=deepseek-v4-flash
#
# --- OpenCode Go ---
# OPENAI_API_KEY=sk-xxx
# SUMMARY_API_URL=https://opencode.ai/zen/go/v1/chat/completions
# SUMMARY_API_MODEL=deepseek-v4-flash
#
# --- OpenAI 官方 ---
# OPENAI_API_KEY=sk-xxx
# SUMMARY_API_MODEL=gpt-4o-mini
#
# --- 任何 OpenAI 兼容 API ---
# OPENAI_API_KEY=your-key-here
# SUMMARY_API_URL=https://your-api-provider.com/v1/chat/completions
# SUMMARY_API_MODEL=your-model-name

OPENAI_API_KEY=
# SUMMARY_API_URL=https://api.openai.com/v1/chat/completions  # 取消注释并改为你用的API地址
SUMMARY_API_MODEL=gpt-4o-mini

# 以下变量代码会读取，但模板此前未列出（实测 7 个，见 private-evidence/t02-env-template-gap.json）。
# 故意只写成注释：许多分支区分「未设置」与「设为空串」，给空值会改变行为。
# 需要覆盖时去掉行首 #，键名与读取处逐字一致。

# BILI_ARCHIVE_DIR=    # 读取处：scripts/batch_transcribe.py, scripts/doctor.py, scripts/import_archive.py, scripts/maintenance.py
# BILI_ASR_CHUNKING=    # 读取处：scripts/asr_chunk.py
# BILI_GPU_LOCK=    # 读取处：scripts/fw_whisper_main.py
# BILI_RISK_COOLDOWNS=    # 读取处：scripts/batch_transcribe.py
# BILI_RISK_RESUME_COOLDOWN=    # 读取处：scripts/batch_transcribe.py
# BILI_TRANSCRIPT_LOG_FILE=    # 读取处：scripts/logger.py
# SUMMARY_API_URL=    # 读取处：scripts/build_knowledge_index.py, scripts/doctor.py, 文档/柠檬/遗留脚本/build_knowledge_index.py
