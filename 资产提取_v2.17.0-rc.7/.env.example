# 资产提取流水线 v2 配置模板
# 复制为 ~/.asset-extract/.env（技能包外，推荐，防随包分发泄漏）或 <技能目录>/.env 后填写；
# 加载顺序：ASSET_ENV_PATH 环境变量 → <技能目录>/.env → ~/.asset-extract/.env

# OpenAI 兼容 API 配置（DeepSeek 等，格式与索引v3 一致）
OPENAI_API_KEY=sk-xxx
SUMMARY_API_URL=https://api.deepseek.com/v1/chat/completions
SUMMARY_API_MODEL=deepseek-chat

# 资产库根目录（默认 <技能目录>/资产库，数据外置）
ASSET_LIB_DIR=

# 直调引擎并发数（默认 32；DeepSeek v4-flash 上限 2500，可自行调高）
ASSET_WORKERS=32

# 单次输出 token 上限（默认 8000；deepseek-chat 上限约 8K，换大窗口模型可调高）
SUMMARY_MAX_TOKENS=8000

# Gemini 生图（可选下游视觉模块；不配置时用 visual_production.py export 手工执行）
# 核心资产反推不需要本组配置——没有密钥时资料交付照常完成。
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_QC_MODEL=gemini-3-pro
GEMINI_IMAGE_SIZE=2K
GEMINI_TIMEOUT_SECONDS=180
