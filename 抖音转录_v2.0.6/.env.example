# 摘要与校正共用的 OpenAI 兼容接口（Chat Completions）
OPENAI_API_KEY=
SUMMARY_API_URL=https://api.openai.com/v1/chat/completions
SUMMARY_API_MODEL=gpt-4o-mini

# 可选：强制覆盖 Whisper 档位（如 small / medium / large-v3）
DOUYIN_WHISPER_MODEL=

# 可选：把日志重定向到别处（测试与 CI 用；默认写 state/logs/transcript.log）
DOUYIN_TRANSCRIPT_LOG_FILE=
